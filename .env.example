# ─────────────────────────────────────────────────────────────────────────────
#  .env.example  —  Variables de entorno para el Auditor de Actas ONPE 2026
#  Copiar este archivo a ".env" y completar con tus valores reales.
#  NUNCA subas el archivo ".env" al repositorio (está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Cloud Document AI (OCR Enterprise) ─────────────────────────────────
# Requerido solo si usas el motor "Google Enterprise OCR".
# Opción recomendada: autenticarse con gcloud CLI (sin necesidad de estas vars)
#   gcloud auth application-default login

GOOGLE_CLOUD_PROJECT=tu-proyecto-gcp
DOCUMENTAI_LOCATION=us
DOCUMENTAI_PROCESSOR_ID=xxxxxxxxxxxxxxxx

# Ruta al JSON de cuenta de servicio (FALLBACK — solo si no usas gcloud CLI)
# GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\a\tu-service-account.json

# Variables legacy (también aceptadas para compatibilidad)
# GOOGLE_CLOUD_PROJECT_ID=tu-proyecto-gcp
# GOOGLE_CLOUD_LOCATION=us
# GOOGLE_CLOUD_PROCESSOR_ID=xxxxxxxxxxxxxxxx

# ── Gemini Flash 2.5 (modo híbrido IA) ───────────────────────────────────────
# Requerido solo si usas el motor "Híbrido IA".
# Obtener API key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu-gemini-api-key

# ── Opcional: impersonación de cuenta de servicio (sin clave privada) ────────
# GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=nombre@proyecto.iam.gserviceaccount.com
